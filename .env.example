# Default is offline deterministic demo. No paid API calls are made.
CASEDESK_PROVIDER=demo
CASEDESK_DEMO_SEED=true
# For a compatible Chat Completions provider, set all three values server-side.
# Export them in your shell, or use Docker Compose's .env support.
# Never put a model API key in the frontend or commit .env.
CASEDESK_MODEL_BASE_URL=https://api.openai.com/v1
CASEDESK_MODEL_NAME=
CASEDESK_MODEL_API_KEY=
CASEDESK_MODEL_TIMEOUT=20
